# Local flavour of the UDP atlas runtime: the docker assembly launched from the workspace
# (Eclipse "Run OSGi" / bnd run). The Event Atlas config bundle reads its values from the
# environment with localhost defaults (Model Atlas :8086, broker :1883, Timescale :5432), so
# set the EVENTATLAS_* / TIMESCALE_* variables of README.md in the launch where they differ.
# Resolve the docker bndrun, not this one: it inherits the -runbundles.
-include: de.jena.udp.atlas.runtime.docker.bndrun

-runtrace: true
-runvm.local: -Duser.dir=${.}/generated/tmp
