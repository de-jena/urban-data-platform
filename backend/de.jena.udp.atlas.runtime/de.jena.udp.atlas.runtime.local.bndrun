# Local flavour of the UDP atlas runtime: the docker assembly launched from the workspace
# (Eclipse "Run OSGi" / bnd run). The Event Atlas config bundle reads its values from the
# environment with localhost defaults (Model Atlas :8086, broker :1883, Timescale :5432), so
# set the EVENTATLAS_* / TIMESCALE_* variables of README.md in the launch where they differ.
-include: de.jena.udp.atlas.runtime.docker.bndrun

-runtrace: true
-runvm.local: -Duser.dir=${.}/generated/tmp
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.22.0,2.22.1)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.20.0,2.20.1)',\
	de.jena.ilsa.sensinact.model;version=snapshot,\
	de.jena.traficam.model;version=snapshot,\
	de.jena.traficam.sensinact.model;version=snapshot,\
	de.jena.udp.atlas.ilsa;version=snapshot,\
	de.jena.udp.atlas.runtime.config;version=snapshot,\
	de.jena.udp.atlas.traficam;version=snapshot,\
	de.jena.udp.trafficos.common.model;version='[1.2.0,1.2.1)',\
	de.jena.udp.trafficos.trafficlight.model;version='[1.2.0,1.2.1)',\
	io.dropwizard.metrics.core;version='[4.2.37,4.2.38)',\
	io.netty.buffer;version='[4.1.133,4.1.134)',\
