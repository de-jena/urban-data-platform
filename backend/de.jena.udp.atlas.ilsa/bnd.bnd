Bundle-Name: UDP :: Atlas :: ILSA
Bundle-Description: Traffic light (ILSA) adapter for the UDP atlas runtime: reads the 5g/ilsa MQTT \
 topics through the gecko messaging MQTT client, decodes the JSON with the Fennec codec and runs the \
 TLConfiguration -> Ilsa transformation on the Fennec M2X QVT-O engine.
Bundle-Version: 1.0.0.SNAPSHOT

-buildpath: \
	org.osgi.framework,\
	org.osgi.service.component,\
	org.osgi.service.component.annotations,\
	org.osgi.util.promise,\
	org.osgi.util.function,\
	org.eclipse.emf.common,\
	org.eclipse.emf.ecore,\
	org.eclipse.fennec.emf.osgi.api,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.m2x.ocl.api;version=latest,\
	org.eclipse.fennec.m2x.ocl.parser;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.m2x.qvto.api;version=latest,\
	org.eclipse.fennec.m2x.qvto.engine;version=latest,\
	org.eclipse.fennec.m2x.qvto.model;version=latest,\
	org.eclipse.fennec.m2x.qvtd.api;version=latest,\
	org.eclipse.sensinact.gateway.core.api,\
	org.eclipse.sensinact.gateway.core.annotation,\
	org.eclipse.sensinact.gateway.core.geo-json,\
	org.eclipse.sensinact.gateway.core.models.provider,\
	org.gecko.osgi.messaging,\
	org.osgi.util.pushstream,\
	de.jena.ilsa.sensinact.model,\
	de.jena.udp.trafficos.trafficlight.model,\
	de.jena.udp.trafficos.common.model

-testpath: \
	junit-jupiter-api,\
	${junit},\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind,\
	com.fasterxml.jackson.core.jackson-annotations,\
	org.antlr.antlr4-runtime;version='[4.13,5)',\
	org.eclipse.emf.ecore.xmi,\
	org.eclipse.fennec.m2x.ocl.engine;version=latest,\
	org.eclipse.fennec.m2x.qvto.parser;version=latest,\
	org.eclipse.fennec.m2x.qvt.model;version=latest,\
	org.eclipse.fennec.m2x.qvtd.model;version=latest,\
	org.eclipse.fennec.m2x.unit;version=latest,\
	org.eclipse.fennec.m2x.unit.osgi;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest

-includeresource: transformations=transformations

-workingset: udp_runtime
