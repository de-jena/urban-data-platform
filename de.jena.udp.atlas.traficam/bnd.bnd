Bundle-Name: UDP :: Atlas :: TrafiCam
Bundle-Description: TrafiCam adapter for the UDP atlas runtime: reads the binary EMF detections \
 and camera configurations on the 5g/traficam MQTT topics through the gecko messaging MQTT client and \
 pushes them as TrafiCam providers.
Bundle-Version: 1.0.0.SNAPSHOT

-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.sensinact.gateway.core.api;version=latest,\
	org.eclipse.sensinact.gateway.core.annotation;version=latest,\
	org.eclipse.sensinact.gateway.core.geo-json;version=latest,\
	org.eclipse.sensinact.gateway.core.models.provider;version=latest,\
	org.gecko.osgi.messaging;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	de.jena.traficam.model;version=snapshot,\
	de.jena.traficam.sensinact.model;version=snapshot,\
	org.eclipse.fennec.event.atlas.mapping;version=latest

-testpath: \
	junit-jupiter-api,\
	${junit},\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind,\
	com.fasterxml.jackson.core.jackson-annotations

-workingset: udp_runtime
