{
  ":configurator:resource-version": 1,
  ":configurator:symbolic-name": "de.jena.udp.atlas.runtime.config.providers",
  ":configurator:version": "1.0.0",


  "FileEObjectProvider~mappings": {
    "emf.eobject.provider.name": "mapping-files",
    "locations": ["$[env:EVENTATLAS_MAPPING_DIR;default=$[prop:EVENTATLAS_MAPPING_DIR;default=/opt/eventatlas/runtime/mappings]]"],
    "key.feature": "mid",
    "osgi.ds.satisfying.condition.target": "(osgi.condition.id=https://fennec.eclipse.org/event.atlas/mapping/1.0)"
  },

  "EObjectRegistry~mappings": {
    "name": "sensinact-mappings",
    "initialProvider.target": "(emf.eobject.provider.name=mapping-files)"
  },
  /* A MappingProfile is pure mapping metamodel, so the condition above is the whole of what this
   * one needs to parse. It cannot live in the mappings registry: that one pins root.eclass.uri to
   * ProviderMapping. */
  "FileEObjectProvider~profiles": {
    "emf.eobject.provider.name": "profile-files",
    "locations": ["$[env:EVENTATLAS_PROFILE_DIR;default=$[prop:EVENTATLAS_PROFILE_DIR;default=/opt/eventatlas/runtime/profiles]]"],
    "key.feature": "profileId",
    "osgi.ds.satisfying.condition.target": "(osgi.condition.id=https://fennec.eclipse.org/event.atlas/mapping/1.0)"
  },

  "EObjectRegistry~profiles": {
    "name": "sensinact-profiles",
    "initialProvider.target": "(emf.eobject.provider.name=profile-files)"
  }
}
  
  