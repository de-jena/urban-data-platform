# UDP runtime on the Fennec atlases (issue #28). Derived from event.atlas'
# eventatlas.runtime_docker.bndrun: the sensiNact mapping engine + gateway, northbound REST,
# SensorThings REST and MQTT, the Model Atlas client and the MQTT/REST southbound adapters.
# Differences to the stock Event Atlas image:
#  - Java 25 and the Felix webconsole (config in de.jena.udp.atlas.runtime.config)
#  - no model inference yet (Fennec AI joins in a later step; its bundles are on the DIM nexus)
#  - UDP-specific adapters are added here step by step (see the issue): ILSA, TrafiCam and IBIS
#    (de.jena.udp.atlas.*) read their 5g/* topics through the gecko messaging MQTT client
#    (org.gecko.adapter.mqtt.v5, MQTTService~read in de.jena.udp.atlas.runtime.config); the DWD
#    forecast comes from the gecko weather MOSMIX fetcher (configs/dwd.json) and is pushed by
#    de.jena.udp.atlas.dwd through the mapping seeded from de.jena.udp.atlas.dwd/eventatlas/seed
# Deployment values come from the environment: org.eclipse.fennec.event.atlas.mapping.docker.config
# resolves the EVENTATLAS_* / TIMESCALE_* / SENSORTHINGS_* placeholders at delivery time.
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active

-runrequires: \
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mapping',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.deployment',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mapping.docker.config',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.mqtt.southbound.adapter',\
	bnd.identity;id='org.eclipse.fennec.event.atlas.rest.southbound.adapter',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.fennec.emf.gecko.compatibility.api',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.jsonschema',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.impl',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.eobject.provider',\
	bnd.identity;id='org.eclipse.sensinact.gateway.core.impl',\
	bnd.identity;id='org.apache.aries.typedevent.bus',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.session.session-impl',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.query-handler-impl',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.rest',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.gogo-shell',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.sensorthings.rest.gateway',\
	bnd.identity;id='org.eclipse.sensinact.gateway.northbound.sensorthings.mqtt',\
	bnd.identity;id='org.eclipse.sensinact.gateway.southbound.history.timescale-provider',\
	bnd.identity;id='org.eclipse.sensinact.gateway.southbound.history.history-core',\
	bnd.identity;id='org.eclipse.osgitech.rest',\
	bnd.identity;id='tools.jackson.module.jackson-module-jakarta-xmlbind-annotations',\
	bnd.identity;id='slf4j.simple',\
	bnd.identity;id='org.apache.felix.webconsole',\
	bnd.identity;id='org.apache.felix.webconsole.plugins.ds',\
	bnd.identity;id='org.apache.felix.webconsole.plugins.event',\
	bnd.identity;id='org.apache.felix.webconsole.plugins.memoryusage',\
	bnd.identity;id='de.jena.udp.atlas.runtime.config',\
	bnd.identity;id='org.gecko.adapter.mqtt.v5',\
	bnd.identity;id='de.jena.udp.atlas.ilsa',\
	bnd.identity;id='de.jena.udp.atlas.traficam',\
	bnd.identity;id='de.jena.udp.atlas.ibis',\
	bnd.identity;id='org.gecko.weather.dwd.forecast',\
	bnd.identity;id='de.jena.udp.atlas.dwd',\
	bnd.identity;id='de.jena.udp.atlas.kml',\
	bnd.identity;id='org.eclipse.sensinact.gateway.southbound.rules.rules.impl',\
	bnd.identity;id='org.eclipse.sensinact.gateway.southbound.rules.easy-rules.osgi',\
	bnd.identity;id='org.eclipse.sensinact.gateway.southbound.rules.easy-rules.config',\
	bnd.identity;id='de.jena.udp.atlas.rules',\
	bnd.identity;id='de.jena.udp.atlas.conflict'

# http.port=-1: the only HTTP whiteboard is the named instance from the docker.config
# bundle (context path event/, port 8080).
-runproperties: \
    osgi.console=,\
    org.osgi.service.http.port=-1,\
    osgi.console.enable.builtin=false,\
    felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation

-runee: JavaSE-25
-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

# The spifly framework-extension variant breaks the typedevent bus at startup. The codec 1.1.0
# line (DIM nexus, org.geckoprojects.codec) satisfies the package imports too, but the Event
# Atlas image is verified against the 0.1.0 line from Maven Central, so keep that one.
-runblacklist: \
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension',\
	bnd.identity;id='jakarta.servlet-api';version:Version='5.0.0',\
	bnd.identity;id='org.eclipse.fennec.codec';version='[1.1.0,2)',\
	bnd.identity;id='org.eclipse.fennec.codec.json';version='[1.1.0,2)',\
	bnd.identity;id='org.eclipse.fennec.codec.jsonschema';version='[1.1.0,2)',\
	bnd.identity;id='org.eclipse.fennec.codec.info';version='[1.1.0,2)',\
	bnd.identity;id='org.eclipse.fennec.codec.info.model';version='[1.1.0,2)',\
	bnd.identity;id='org.eclipse.fennec.codec.constants';version='[1.1.0,2)',\
	bnd.identity;id='net.opengis.wfs2.model'
