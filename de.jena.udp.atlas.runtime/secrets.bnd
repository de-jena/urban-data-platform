# Local secrets for de.jena.udp.atlas.runtime.local.bndrun (not in git).
# The configs read environment variables ($[env:...]), so they go into -runenv, not -D.
-runenv: \
	EVENTATLAS_MQTT_PROTOCOL=tcp,\
  	EVENTATLAS_MQTT_HOST=localhost,\
    EVENTATLAS_MQTT_PORT=1884,\
	TIMESCALE_PWD=test.password,\
	SENSORTHINGS_MQTT_PORT=3883,\
	EVENTATLAS_ATLAS_SCOPE=udp,\
  	EVENTATLAS_DOMAIN_NSURI=https://model.data.jena.de/chirpstack/uplink/1.0,\
  	EVENTATLAS_DEPLOYMENT_REGISTRY=configurations
