Bundle-Name: UDP :: Atlas :: Cloudevent :: Listener
Bundle-Description: Listeners that wraps payloads into CloudEvents and pushes them to SensiNact

-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.osgi.util.function;version=latest,\
	org.eclipse.emf.common;version=latest,\
	org.eclipse.emf.ecore;version=latest,\
	org.eclipse.sensinact.gateway.core.api;version=latest,\
	org.eclipse.sensinact.gateway.core.annotation;version=latest,\
	org.eclipse.sensinact.gateway.core.geo-json;version=latest,\
	org.eclipse.sensinact.gateway.core.models.provider;version=latest,\
	org.gecko.osgi.messaging;version=latest,\
	org.osgi.util.pushstream;version=latest,\
	org.eclipse.fennec.event.atlas.mapping;version=latest,\
	io.cloudevents.model;version=latest,\
	org.apache.felix.metatype;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.annotation.versioning;version=latest
-testpath: \
	junit-jupiter-api,\
	${junit},\
	org.gecko.util.pushstream;version=latest,\
	org.eclipse.emf.ecore.xmi;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest

-workingset: udp_runtime
